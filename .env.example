# Salin file ini menjadi .env, lalu isi nilainya di server.

# Database
DB_HOST=localhost
DB_NAME=simkeusi_koperasi_db
DB_USER=root
DB_PASSWORD=

# WhatsApp Cloud API (Meta for Developers > WhatsApp > API Setup)
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
WA_GRAPH_VERSION=
WA_TEMPLATE_NAME=pengingat_angsuran_h1
WA_TEMPLATE_LANG=id

# Wajib bila Cron dipanggil melalui URL.
# Buat dengan: php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
CRON_SECRET=
